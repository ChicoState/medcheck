# Local development settings only. These defaults are intentionally non-secret.
# Copy to .env to override them; never commit a real .env file.
POSTGRES_DB=medcheck
POSTGRES_USER=medcheck
POSTGRES_PASSWORD=medcheck_local_only
POSTGRES_PORT=127.0.0.1:5432
# Django connection values; POSTGRES_PORT above is the Compose port binding.
POSTGRES_HOST=127.0.0.1
POSTGRES_DB_PORT=5432

# Export these values into the shell before running Django commands locally.
# Replace the development-only key outside local development.
DJANGO_SECRET_KEY=local-development-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
